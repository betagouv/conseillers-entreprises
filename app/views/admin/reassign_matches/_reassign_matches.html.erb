<div class="without_sidebar" id="active_admin_content">
  <div id="main_content_wrapper">
    <div id="main_content">
      <div class="active-admin-form panel">
        <h3><%= t('.select_expert') %></h3>
        <div class="panel_contents">
          <p class="information"><%= t('.matches_to_reassign', count: expert.received_matches.in_progress.count) %></p>
          <%= form_with(url: admin_expert_reassign_matches_path(expert), method: :get, local: true) do |f| %>
            <li class="input stringish">
              <%= f.label :antenne_id, t('.antenne') %>
              <%= f.select :antenne_id, options_from_collection_for_select(antennes, :id, :name, selected_antenne.id) %>
            </li>
            <%= f.submit t('.show_experts') %>
          <% end %>
          <%= form_with(url: admin_expert_reassign_matches_reassign_path, local: true) do |f| %>
            <li class="input required stringish">
              <%= f.label :selected_expert_id, t('.expert') %>
              <%= f.select :selected_expert_id, options_from_collection_for_select(candidate_experts, :id, :full_name, params[:selected_expert_id]), {}, required: true %>
            </li>
            <%= f.submit t('.save') %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
