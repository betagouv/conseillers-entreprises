<%# locals: (subjects:, institution:) %>


<%= form_with url: annuaire_search_path, local: true do |f| %>
  <div data-controller="stats" data-url="<%= annuaire_load_filter_options_path %>">
    <div class="fr-search-bar" role="search" data-autocomplete-url-value="<%= annuaire_autocomplete_path %>" data-controller="autocomplete" data-autocomplete-min-length-value="3">
      <label class="fr-label" for="search-input"><%= t('search') %></label>
      <input class="fr-input" id="search-input" data-autocomplete-target="input" placeholder="<%= t('annuaire.search.free_text_search') %>" type="search">
      <%= f.hidden_field :query, 'data-autocomplete-target': 'hidden' %>
      <ul class="list-group" data-autocomplete-target="results"></ul>
      <button title="<%= t('annuaire.search.form.submit') %>>" type="submit" class="fr-btn"><%= t('annuaire.search.form.submit') %></button>
    </div>
  </div>
<% end %>
