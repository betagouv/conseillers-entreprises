<%# locals: (subjects:) %>

<%= form_with url: annuaire_search_path, local: true, class: 'fr-mb-3w' do |f| %>
  <%= f.hidden_field :institution_slug, value: params[:institution_slug].presence || (institution.slug if defined?(institution) && institution.present?) %>
  <div class="fr-grid-row fr-grid-row--gutters" data-controller="filters" data-url="<%= annuaire_load_filter_options_path %>">
    <div class="fr-col">
      <div class="fr-input-group fr-pr-2v">
        <div class="autocomplete-field" data-autocomplete-url-value="<%= annuaire_autocomplete_path %>" data-controller="autocomplete" data-autocomplete-min-length-value="3">
          <%= f.label :query, t('search'), class: 'fr-label' %>
          <% if params[:antenne_id] %>
            <% query = "Antenne-#{params[:antenne_id]}" %>
            <% value = Antenne.find(params[:antenne_id]).name %>
          <% end %>
          <% if params[:advisor] %>
            <% query = "User-#{params[:advisor]}" %>
            <% value = "#{User.find(params[:advisor]).full_name} (#{User.find(params[:advisor]).antenne})" %>
          <% end %>
          <%= f.hidden_field :query, 'data-autocomplete-target': 'hidden', value: query %>
          <input class="fr-input" data-autocomplete-target="input" type="text" value="<%= value %>">
          <ul class="list-group" data-autocomplete-target="results"></ul>
        </div>
      </div>
    </div>
    <div class="fr-col">
      <div class="fr-select-group">
        <%= f.label :region_code, t('attributes.region'), class: 'fr-label' %>
        <%= f.collection_select :region_code, RegionOrderingService.call, :code, :nom, { selected: index_search_params[:region_code], include_blank: t('all.feminine') }, class: "fr-select" %>
      </div>
    </div>
    <div class="fr-col">
      <div class="fr-select-group">
        <%= f.label :theme_id, class: 'fr-label' do %>
          <%= t('attributes.theme') %>
          <div class="loader loader--sm hidden" data-filters-target="loader"></div>
        <% end %>
        <%= f.collection_select :theme_id, Theme.order(:label), :id, :label, { selected: index_search_params[:theme_id], include_blank: t('all.masculin') }, class: "fr-select", data: { action: 'change->filters#fetchFilters', 'filters-target': 'themes' } %>
      </div>
    </div>
    <div class="fr-col">
      <div class="fr-select-group">
        <%= f.label :subject_id, t('attributes.subject'), class: 'fr-label' %>
        <%= f.collection_select :subject_id, subjects, :id, :label, { selected: index_search_params[:subject_id], include_blank: t('all.masculin') }, class: "fr-select", data: { 'filters-target': 'subjects' } %>
      </div>
    </div>
  </div>
  <% if params[:advisor].present? || params[:antenne_id].present? || index_search_params[:theme_id].present? || index_search_params[:subject_id].present? || index_search_params[:query].present? || index_search_params[:region_code].present? %>
    <%= link_to t('clear_search'), request.fullpath.split('?').first + "?reset_query=true", id: 'clear-search', class: 'fr-btn fr-btn--tertiary-no-outline' %>
  <% end %>
  <%= f.submit t('.submit'), class: 'fr-btn fr-mt-2w' %>
<% end %>
