<%# locals: (antenne:, all_users_size:, preview:) %>

<th class="td-header td-header--antenne annuaire-cell--changes" data-changes="<%= antenne&.import_change_type %>" rowspan="<%= all_users_size %>">
  <% if preview %>
    <span><%= antenne %></span>
  <% else %>
    <%= link_to antenne, admin_antenne_path(antenne) %>
  <% end %>
</th>
