<%# locals: (antenne:, all_users_size:, preview:) %>

<th class="td-header td-header--antenne annuaire-cell--changes" rowspan="<%= all_users_size %>" data-changes=<%= antenne&.import_change_type %>>
  <% if preview %>
    <span><%= antenne %></span>
  <% else %>
    <%= link_to antenne, admin_antenne_path(antenne) %>
  <% end %>
</th>
