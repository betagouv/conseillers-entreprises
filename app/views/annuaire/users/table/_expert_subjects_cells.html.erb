<%# locals: (grouped_subjects:, expert:, users:) %>

<% old_expert = @old_data&.experts&.find{ it.email == expert.email } %>
<%# in_imported_set = @result&.objects&.flat_map(&:experts)&.find{it.email == expert.email} %>

<% grouped_subjects.each_value do |subjects| %>
  <% subjects.each_value do |institutions_subjects| %>
    <% institutions_subjects.each do |institution_subject| %>
      <% expert_subject = expert&.experts_subjects&.find{ it.institution_subject_id == institution_subject.id } %>

      <% old_expert_subject = old_expert&.experts_subjects&.find{ it.institution_subject_id == institution_subject.id } %>

      <%
        css_class = if old_expert_subject.present? != expert_subject.present?
          'updated'
        else
          'touched'
        end
      %>

      <%# The InstitutionSubjects cells themselves are spanned on all the rows of the members of the expert team. %>
      <td class="user-cell--<%= css_class %>" rowspan="<%= users.size %>">
        <% if expert_subject.present? %>
          <% intervention_criteria = expert_subject.intervention_criteria %>
          <% if intervention_criteria.present? %>
            <div class="tooltip" tab-index="-1">
              <%= t('yes') %>
              <span class="tooltiptext"><%= intervention_criteria %></span>
            </div>
          <% else %>
            <%= t('yes') %>
          <% end %>
        <% end %>
      </td>
    <% end %>
  <% end %>
<% end %>
