<%# locals: (expert:, users_size:, preview:) %>

<th class="td-header td-header--expert annuaire-cell--changes" rowspan="<%= users_size %>" data-changes=<%= expert.import_change_type %>>
  <% if expert.persisted? %>
    <% if preview %>
      <span><%= expert.full_name %></span>
    <% else %>
      <%= link_to expert.full_name, admin_expert_path(expert) %>
    <% end %>
    <% if expert.territorial_zones.any? %>
      <span class="ri-map-2-line blue fr-ml-1v" aria-hidden="true" title="<%= t('annuaire_helper.build_user_name_cell.specific_territories') %>"></span>
    <% end %>
    <% if expert.import_attributes_diff.present? %>
      <%= render 'annuaire/users/table/attribute_diff', object: expert %>
    <% end %>
<% end %>
</th>
