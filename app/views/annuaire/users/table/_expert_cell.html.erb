<%# locals: (expert:, users_size:, import_changes:) %>

<% old_expert = @old_data&.experts&.find{ it.email == expert.email } %>
<% in_imported_set = @result&.objects&.flat_map(&:experts)&.find{it.email == expert.email} %>

<%
  css_class = if old_expert.present? && in_imported_set.present?
    'touched'
  elsif !old_expert.present? && in_imported_set.present?
    'created'
  elsif old_expert.present? && !in_imported_set.present?
    'removed'
  end
%>

<td class="td-header td-header--expert user-cell--<%= css_class %>" rowspan="<%= users_size %>">
  <% if expert.persisted? %>
    <% if import_changes.present? %>
      <span><%= expert.full_name %></span>
    <% else %>
      <%= link_to expert.full_name, admin_expert_path(expert) %>
    <% end %>
    <% if expert.territorial_zones.any? %>
      <span class="ri-map-2-line blue fr-ml-1v" aria-hidden="true" title="<%= t('annuaire_helper.build_user_name_cell.specific_territories') %>"></span>
    <% end %>
  <% end %>
</td>
