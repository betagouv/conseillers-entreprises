<%# locals: (grouped_subjects:, grouped_experts:) %>

<div class="fr-table fr-table--multiline">
  <div class="fr-table__wrapper">
    <div class="fr-table__container">
      <div class="fr-table__content">
        <table>
          <%= render 'annuaire/users/table/header', grouped_subjects: grouped_subjects, load_coverage: false && !large_search?(grouped_experts, grouped_subjects) %>
          <tbody>
            <% grouped_experts.each do |antenne, experts| %>

              <% all_users = experts.values.flatten %>
              <% experts.each_with_index do |expert_and_users, index_in_antenne| %>
                <% expert, users = expert_and_users %>
                <% users.each_with_index do |user, index_in_expert| %>
                  <% expert_first_row = index_in_expert == 0 %>
                  <% antenne_first_row = index_in_antenne == 0 && index_in_expert == 0 %>
                  <tr>
                    <%= render('annuaire/users/table/antenne_cell', antenne: antenne, size: all_users.size) if antenne_first_row %>
                    <%= render('annuaire/users/table/expert_cell', expert: expert, users: users, antenne: antenne) if expert_first_row %>
                    <%= render 'annuaire/users/table/user_cell', import_changes: import_changes, user: user, antenne: antenne %>
                    <%= render('annuaire/users/table/expert_subjects_cells', grouped_subjects: grouped_subjects, expert: expert, users: users) if expert_first_row %>
                  </tr>
                <% end %>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
