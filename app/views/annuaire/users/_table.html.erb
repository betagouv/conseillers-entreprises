<%# locals: (grouped_subjects:, grouped_experts:) %>

<div class="fr-table--c-annuaire">
  <table>
    <%= render 'annuaire/users/table/header', grouped_subjects: grouped_subjects, load_coverage: false && !large_search?(grouped_experts, grouped_subjects) %>
    <tbody>
      <% grouped_experts.each do |antenne, experts| %>
        <% experts.each do |expert, users| %>
          <%# optionaly skip if expert does not contain any objects in @result.objects %>

          <% users.each_with_index do |user, index_in_expert| %>
            <%# hightlight: the rows in @result.objects %>
            <%# highlighted_ids = @result.objects.compact.map(&:id) %>
            <% expert_first_row = index_in_expert == 0 %>
            <% antenne_first_row = expert == experts.keys.first && expert_first_row %>
            <% antenne_separation_class = antenne_first_row ? 'tr--distinct' : '' %>
            <% highlighted_class = (@result && (user.in? @result&.objects)) ? 'blue' : '' %>
            <% # if highlighted_class do stuff with @result.rows[@result.objects.index(user)] %>
            <tr class="<%= [antenne_separation_class, highlighted_class].compact.join(" ") %>">
              <%= render('annuaire/users/table/antenne_cell', antenne: antenne, experts: experts) if antenne_first_row %>
              <%= render('annuaire/users/table/expert_cell', expert: expert, users: users, antenne: antenne) if expert_first_row %>
              <%= render 'annuaire/users/table/user_cell', user: user, antenne: antenne %>
              <%= render('annuaire/users/table/expert_subjects_cells', grouped_subjects: grouped_subjects, expert: expert, users: users) if expert_first_row %>
            </tr>
          <% end %>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
