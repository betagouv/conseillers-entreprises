<%# locals: (users_data:, highlighted_objects: []) %>

<div class="fr-table fr-table--multiline fr-table--bordered fr-table--c-annuaire">
  <div class="fr-table__wrapper">
    <div class="fr-table__container">
      <div class="fr-table__content">
        <table>
          <%= render 'annuaire/users/table/header', grouped_subjects: users_data.grouped_subjects, load_coverage: !large_users_data?(users_data) %>
          <tbody>
          <%  %>
            <% users_data.grouped_experts.each do |antenne, experts| %>

              <% all_users = experts.values.flatten %>
              <% experts.each_with_index do |expert_and_users, index_in_antenne| %>
                <% expert, users = expert_and_users %>
                <% users.each_with_index do |user, index_in_expert| %>
                  <% expert_first_row = index_in_expert == 0 %>
                  <% antenne_first_row = index_in_antenne == 0 && index_in_expert == 0 %>
                  <tr class="tr--distinct">
                    <%= render('annuaire/users/table/antenne_cell', antenne: antenne, all_users_size: all_users.size, preview: users_data.preview?) if antenne_first_row %>
                    <%= render('annuaire/users/table/expert_cell', expert: expert, users_size: users.size, preview: users_data.preview?) if expert_first_row %>
                    <%= render('annuaire/users/table/user_cell', user: user, preview: users_data.preview?, highlighted: highlighted_objects&.include?(user)) %>
                    <%= render('annuaire/users/table/expert_subjects_cells', users_data: users_data, expert: expert, users_size: users.size) if expert_first_row %>
                  </tr>
                <% end %>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
