<%# locals: () %>


<div class="annuaire-import-menu fr-mb-3w">
  <%= render "annuaire/file_imports/import_dialog", entity: "User" %>
  <button class="fr-btn fr-btn--tertiary fr-icon-settings-5-line fr-btn--icon-left"><%= t(".actions") %></button>
  <div class="annuaire-import-menu__content">
    <%= link_to institution_users_path(format: 'csv', antenne_id: params[:antenne_id].presence, region_code: params[:region_code].presence) do %>
      <%= t('download_csv') %>
    <% end %>

    <%= link_to institution_users_path(format: 'xlsx', antenne_id: params[:antenne_id].presence, region_code: params[:region_code].presence) do %>
      <%= t('download_xls') %>
    <% end %>

    <button data-fr-opened="false" aria-controls="import_dialog" type="button"><%= t('.import') %></button>

    <% if @users_data.not_invited_users.present? || true %>
      <%= form_with url: send_invitations_institution_users_path, local: true do |f| %>
        <%= f.hidden_field :users_ids, value: @users_data.not_invited_users.map(&:id) %>
        <%= f.hidden_field :slug, value: params[:institution_slug] %>
        <%= f.submit t('annuaire.users.index.send_invitations', count: @users_data.not_invited_users.length) %>
      <% end %>
    <% end %>
  </div>
</div>
