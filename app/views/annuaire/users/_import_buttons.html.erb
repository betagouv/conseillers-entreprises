<%# locals: () %>

<div class="fr-mb-3w">
  <span class="fr-ml-2w">
    <%= link_to institution_users_path(format: 'csv', antenne_id: params[:antenne_id].presence, region_code: params[:region_code].presence) do %>
      <span class="ri-download-2-line fr-mr-1w" aria-hidden="true"></span>
      <%= t('download_csv') %>
    <% end %>
  </span>
  <span class="fr-ml-2w">
    <%= link_to institution_users_path(format: 'xlsx', antenne_id: params[:antenne_id].presence, region_code: params[:region_code].presence) do %>
      <span class="ri-download-2-line fr-mr-1w" aria-hidden="true"></span>
      <%= t('download_xls') %>
    <% end %>
  </span>
  <span class="fr-ml-2w">
    <%= link_to new_institution_file_import_path(entity: "User") do %>
      <span class="ri-upload-2-line fr-mr-1w" aria-hidden="true"></span>
      <%= t('import') %>
    <% end %>
  </span>
</div>
