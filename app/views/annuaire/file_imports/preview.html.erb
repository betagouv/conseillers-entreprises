<div class="fr-container">
  <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--right">
    <div class="fr-col fr-col-2">
      <%= link_to "Revoir l’analyse", analysis_institution_file_import_path, class: "fr-btn fr-btn--secondary" %>
    </div>
    <div class="fr-col fr-col-2">
      <%= button_to t('.commit'), commit_institution_file_import_path, method: :put, class: "fr-btn fr-btn--primary", disabled: @import.completed? %>
    </div>
  </div>
</div>

<% case @import.entity.to_s %>
<% when "User" %>
  <% if @users_data.grouped_experts.present? %>
    <div class="fr-container-fluid">
      <%= render 'annuaire/users/table', grouped_subjects: @users_data.grouped_subjects, grouped_experts: @users_data.grouped_experts %>
    </div>
  <% else %>
    <div class="fr-container">
      <div class="fr-alert fr-alert--info fr-alert--sm">
        <p><%= t('.no_users') %></p>
      </div>
    </div>
  <% end %>
<% when "Antenne" %>
  <% if @antennes.present? %>
    <div class="fr-container-fluid">
      <%= render 'annuaire/antennes/table', antennes: @antennes %>
    </div>
  <% else %>
    <div class="fr-container">
      <div class="fr-alert fr-alert--info fr-alert--sm">
        <p><%= t('.no_antenne') %></p>
      </div>
    </div>
  <% end %>
<% end %>
