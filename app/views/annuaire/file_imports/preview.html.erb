<% meta title: @institution.name %>
<% content_for :header, render('header', import: @import, current: "preview") %>


<!-- Add display filter here -->

<% case @import.entity.to_s %>
<% when "User" %> <%# split in two partials %>
  <% if @import_changes.filtered.present? %>
    <div class="fr-container-fluid">
      <%= render 'annuaire/users/table', subjects_data: @subjects_data, import_changes: @import_changes %>
    </div>
  <% else %>
    <div class="fr-container">
      <div class="fr-alert fr-alert--info fr-alert--sm">
        <p><%= t('annuaire.users.index.no_users') %></p>
      </div>
    </div>
  <% end %>
<% when "Antenne" %>
  <% if @antennes.present? %>
    <div class="fr-container-fluid">
      <%= render 'annuaire/antennes/table', antennes: @antennes %> <%# pass @result  %>
    </div>
  <% else %>
    <div class="fr-container">
      <div class="fr-alert fr-alert--info fr-alert--sm">
        <p><%= t('annuaire.antennes.index.no_antenne') %></p>
      </div>
    </div>
  <% end %>
<% end %>
