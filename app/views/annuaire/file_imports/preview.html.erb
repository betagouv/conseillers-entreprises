<% meta title: @institution.name %>
<% content_for :header, render('header', import: @import, current: "preview") %>


<% if @import.entity.to_s == "User" %>
  <div class="fr-container">
    <div class="annuaire-header">
      <%= form_with url: request.url, method: :get, local: true do |f| %>
        <div class="fr-grid-row fr-grid-row--gutters">
          <div class="fr-col">

            <fieldset class="fr-fieldset fr-mb-0">
              <div class="fr-fieldset__element fr-fieldset__element--inline">
                <%= f.label :display, t(".display_filter"), class: 'fr-label' %>
              </div>
              <div class="fr-fieldset__element fr-fieldset__element--inline fr-fieldset__element--inline-grow">
                <% values = Annuaire::ImportedUsersData::FILTERS %>
                <% options = options_for_select(values.index_by{ t(it, scope: "annuaire.file_imports.preview.filter")}, selected: params[:display_filter]) %>
                <%= f.select :display_filter, options, {}, class: "fr-select",
                             data: { controller: "direct-submit", action: "direct-submit#submit" }
                %>
              </div>
            </fieldset>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>


<% case @import.entity.to_s %>
<% when "User" %> <%# split in two partials %>
  <% if @users_data.grouped_experts.present? %>
    <div class="fr-container-fluid">
      <%= render 'annuaire/users/table', users_data: @users_data %>
    </div>
  <% else %>
    <div class="fr-container">
      <div class="fr-alert fr-alert--info fr-alert--sm">
        <p><%= t('annuaire.users.index.no_users') %></p>
      </div>
    </div>
  <% end %>
<% when "Antenne" %>
  <% if @antennes.present? %>
    <div class="fr-container-fluid">
      <%= render 'annuaire/antennes/table', antennes: @antennes, highlighted_objects: @result.objects %>
    </div>
  <% else %>
    <div class="fr-container">
      <div class="fr-alert fr-alert--info fr-alert--sm">
        <p><%= t('annuaire.antennes.index.no_antenne') %></p>
      </div>
    </div>
  <% end %>
<% end %>
