<% meta title: @institution.name %>
<% content_for :header, render('header', institution: @institution) %>
<% content_for :menu, render('menu', institution: @institution) %>

<div class="fr-container">
  <div class="annuaire-header">
    <%= render 'form', institution: @institution %>
    <%= render 'import_buttons' %>
  </div>
</div>

<% if @antennes.present? %>
  <div class="fr-container--fluid">
    <%= render 'table', antennes: @antennes %>
  </div>
<% else %>
  <div class="fr-container">
    <div class="fr-alert fr-alert--info fr-alert--sm">
      <p><%= t('.no_antenne') %></p>
    </div>
  </div>
<% end %>
