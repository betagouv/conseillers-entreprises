<% meta title: Institution.model_name.human.pluralize %>
<% content_for :header, render('header', institution: @institution) %>

<div class="fr-container">
  <%= render 'annuaire/search/simple_form', subjects: @subjects, institution: @institution %>
</div>

<div class="fr-container">
  <h2><%= title %></h2>
  <%= render 'form', subjects: @subjects %>
</div>

<% if @institutions.present? %>
  <div class="fr-container-fluid">
    <%= render 'table', institutions: @institutions %>
  </div>
<% else %>
  <div class="fr-container">
    <div class="fr-alert fr-alert--info fr-alert--sm">
      <p><%= t('.no_institution') %></p>
    </div>
  </div>
<% end %>
