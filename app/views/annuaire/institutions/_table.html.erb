<%# locals: (institutions:) %>

<div class="fr-table fr-table--multiline fr-table--bordered fr-table--c-annuaire">
  <div class="fr-table__wrapper">
    <div class="fr-table__container">
      <div class="fr-table__content">
        <table>
          <thead>
            <tr>
              <th scope="col"><%= t('activerecord.models.institution.other') %></th>
              <th scope="col"><%= t('activerecord.models.subject.other') %></th>
              <th scope="col"><%= t('activerecord.models.antenne.other') %></th>
              <th scope="col"><%= t('attributes.advisors.other') %></th>
            </tr>
          </thead>
          <tbody>
            <% institutions.each do |institution| %>
              <tr>
                <td class="fr-enlarge-link">
                  <%= display_logo(name: institution.logo&.filename, path: "institutions/") if institution.logo.present? %>
                  <%= link_to institution.name, institution_users_path(institution, region_code: params[:region_code].presence) %>
                </td>
                <td class="fr-enlarge-link">
                  <%= link_to [institution, :subjects] do %>
                    <ul>
                      <% institution.institutions_subjects.group_by(&:theme).each do |theme, institutions_subjects| %>
                        <li><%= theme.label %> (<%= institutions_subjects.size %>)</li>
                      <% end %>
                    </ul>
                  <% end %>
                </td>
                <td class="fr-enlarge-link">
                  <%= link_to institution_antennes_path(institution, region_code: params[:region_code].presence) do %>
                    <%= institution.antennes.human_count %>
                  <% end %>
                </td>
                <td class="fr-enlarge-link">
                  <%= link_to institution_users_path(institution, region_code: params[:region_code].presence) do %>
                    <%= institution.advisors.human_count %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
