<%
  main_title = landing_subject.meta_title.presence || landing_subject.title.presence || landing_subject.landing_theme.meta_title
  secondary_title = if defined?(step_data)
    [t("solicitations.creation_form.steps.#{step_data[:current_status]}"),
     t('step_number', actual: step_data[:current_step], total: step_data[:total_steps])].join(' - ')
  else
    t('solicitations.creation_form.form_complete')
  end
  title = [main_title, secondary_title].join(' - ')
  description = landing_subject.meta_description.presence || landing_subject.description
  meta title: title, description: description
  add_page_schema(page_schema(title: title, description: description, breadcrumb: true))
%>

<% unless in_iframe? %>
  <div class="lighter-blue-bg">
    <div class="fr-container landing fr-pt-8v fr-pt-md-14v fr-pb-2v fr-pb-md-8v">
      <div class="fr-grid-row fr-grid-row--center landing-header">
        <div class="fr-col-12 fr-col-md-8 landing-header__description">
          <h1 class="fr-h2"><%= landing_subject&.form_title.presence || landing_subject.title %></h1>
          <% subject_subtitle = t(landing_subject.slug, scope: 'landing_subject_subtitle', default: t('default', scope: 'landing_subject_subtitle')) %>
          <% count = stats_count(needs_count) %>
          <p class="text-dark-grey fr-text--lg"><%= t('landings.landings.home.subtitle', count: count, subject: subject_subtitle) %></p>
        </div>
        <div class="fr-col-12 fr-col-md-4 landing-header__picture">
          <%= header_picture_tag %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<% if show_breadcrumbs? %>
  <%= render 'pages/breadcrumbs', landing: landing, landing_theme: landing_subject.landing_theme, landing_subject: landing_subject %>
<% end %>
