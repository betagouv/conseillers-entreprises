<% cache [footer_landing, footer_landing_themes] do %>
  <footer class="fr-footer" id="footer" role="contentinfo">
    <% query_params ||= {} %>
    <div class="fr-footer__top">
      <div class="fr-container">
        <div class="fr-grid-row fr-grid-row--start fr-grid-row--gutters fr-py-1w">
          <% if defined?(footer_landing_themes) %>
            <div class="fr-col-12 fr-col-sm-8">
              <h3 class="fr-footer__top-cat"><%= t('.themes') %></h3>
              <ul class="fr-footer__top-list columns-2">
                <% footer_landing_themes.each do |landing_theme| %>
                  <% path = { controller: "landings/landing_themes", action: "show", landing_slug: footer_landing.slug, slug: landing_theme.slug, anchor: 'section-breadcrumbs' }.merge(query_params) %>
                  <li>
                    <%= link_to landing_theme.title, path, class: 'fr-footer__top-link' %>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
          <div class="fr-col-12 fr-col-sm-4">
            <h3 class="fr-footer__top-cat"><%= t('.know_us') %></h3>
            <ul class="fr-footer__top-list">
              <li>
                <%= link_to t('.who_are_we'), equipe_path, class: 'fr-footer__top-link' %>
              </li>
              <li>
                <%= link_to t('.service_presentation'), '/Brochure_Service_Public_Conseillers_entreprises.pdf', title: t('.service_presentation_title'), class: 'fr-footer__top-link', target: '_blank', rel: 'noopener' %>
              </li>
              <li>
                <%= link_to t('.source_code'), 'https://github.com/betagouv/conseillers-entreprises', title: to_new_window_title(t('.github_title')), target: '_blank', rel: 'noopener', class: 'fr-footer__top-link' %>
              </li>
              <li>
                <%= link_to t('usage_stats'), public_index_path, class: 'fr-footer__top-link' %>
              </li>
              <% if policy([:stats, :team]).index? %>
                <li>
                  <%= link_to t('usage_team_stats'), team_index_path, class: 'fr-footer__top-link' %>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="fr-container">
      <div class="fr-footer__body">
        <div class="fr-footer__brand fr-enlarge-link">
          <p class="fr-logo">
            République
            <%= succeed "Fran\u00E7aise" do %>
              <br>
            <% end %>
          </p>
        </div>
        <div class="fr-footer__content">
          <p class="fr-footer__content-desc"><%= t('app_tagline') %></p>
          <p class="fr-footer__content-desc"><%= t('.service_short_description') %></p>
          <ul class="fr-footer__content-list">
            <li class="fr-footer__content-item">
              <%= link_to 'info.gouv.fr', 'https://info.gouv.fr', title: to_new_window_title(t('.info_gouv_title')), target: '_blank', rel: 'noopener', class: 'fr-footer__content-link' %>
            </li>
            <li class="fr-footer__content-item">
              <%= link_to 'service-public.gouv.fr', 'https://service-public.gouv.fr', title: to_new_window_title(t('.service_public_title')), target: '_blank', rel: 'noopener', class: 'fr-footer__content-link' %>
            </li>
            <li class="fr-footer__content-item">
              <%= link_to 'legifrance.gouv.fr', 'https://legifrance.gouv.fr', title: to_new_window_title(t('.legifrance_title')), target: '_blank', rel: 'noopener', class: 'fr-footer__content-link' %>
            </li>
            <li class="fr-footer__content-item">
              <%= link_to 'data.gouv.fr', 'https://data.gouv.fr', title: to_new_window_title(t('.datagouv_title')), target: '_blank', rel: 'noopener', class: 'fr-footer__content-link' %>
            </li>
          </ul>
        </div>
      </div>
      <div class="fr-footer__bottom">
        <ul class="fr-footer__bottom-list">
          <li class="fr-footer__bottom-item">
            <%= link_to t('about.accessibilite.footer_title'), accessibilite_path, class: 'fr-footer__bottom-link' %>
          </li>
          <li class="fr-footer__bottom-item">
            <%= link_to t('about.mentions_legales.title'), mentions_legales_path, class: 'fr-footer__bottom-link' %>
          </li>
          <li class="fr-footer__bottom-item">
            <%= link_to t('about.mentions_d_information.title'), mentions_d_information_path, class: 'fr-footer__bottom-link' %>
          </li>
          <li class="fr-footer__bottom-item">
            <%= link_to t('cgu'), cgu_path, class: 'fr-footer__bottom-link' %>
          </li>
          <li class="fr-footer__bottom-item">
            <button class="link fr-footer__bottom-link" id="open-cookies-box" aria-label="<%= t('.open_cookies') %>">
              <%= t('.cookies') %>
            </button>
          </li>
          <li class="fr-footer__bottom-item">
            <%= link_to t('sitemap.sitemap.title'), sitemap_path, class: 'fr-footer__bottom-link' %>
          </li>
          <li class="fr-footer__bottom-item">
            <%= link_to 'entreprendre.service-public.gouv.fr', 'https://entreprendre.service-public.fr/', title: to_new_window_title(t('.entreprendre_service_public_title')), target: '_blank', rel: 'noopener', class: 'fr-footer__bottom-link' %>
          </li>
        </ul>
      </div>
    </div>
  </footer>
<% end %>
