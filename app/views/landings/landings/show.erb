<% meta title: @landing.meta_title.presence || @landing.title, %>
<% description: @landing.meta_description.presence %>
<%  %>
<% cache_unless(flash.present?, [@landing, @landing_themes, query_params]) do %>
  <% unless in_iframe? %>
    <div class="fr-container-fluid fr-py-7w fr-mt-3v home-banner">
      <div class="fr-container">
        <div class="fr-grid-row fr-grid-row--gutters">
          <div class="fr-col-12 fr-col-md-7" id="col-text">
            <div class="home-title">
              <div class="heading">
                <h1 class="fr-m-0"><%= @landing.title %></h1>
              </div>
              <p class="fr-mt-3w"><%= t('landings.landings.home.answer') %></p>
              <div class="fr-grid-row" id="links">
                <%= render 'pages/cta_button' %>
              </div>
            </div>
          </div>
          <div class="fr-col-12 fr-col-md-5" id="col-image">
            <%= header_picture_tag %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
  <% unless in_iframe? %>
    <div id="scroll-section"></div>
  <% end %>
  <%= render 'landings/landings/information_banner', landing: @landing %>
  <% if @landing.layout_single_page? %>
    <%= render 'single_page', landing_themes: @landing.landing_themes, landing: @landing %>
  <% else %>
    <div class="fr-container-fluid light-blue-bg fr-py-4w landing-theme-section landing">
      <div class="fr-container">
        <%= render 'multiple_steps', landing_themes: @landing_themes, landing: @landing %>
      </div>
    </div>
  <% end %>
  <% unless in_iframe? %>
    <div class="fr-container-fluid light-blue-bg landing">
      <%= render 'pages/how_it_works_short' %>
    </div>
    <div class="fr-container fr-py-7w">
      <%= render 'logos', landing: @landing %>
    </div>
  <% end %>
  <% if in_iframe? && @landing.display_pde_partnership_mention? %>
    <%= render 'landings/landings/pde_partnership_mention' %>
  <% end %>
<% end %>
