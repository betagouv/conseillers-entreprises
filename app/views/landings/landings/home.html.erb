<% setup_home_seo_schemas(landing_themes: @landing_themes, landing: @landing) %>
<div class="fr-container-fluid fr-py-8w home-banner">
  <div class="fr-container">
    <div class="fr-grid-row fr-grid-row--gutters">
      <div class="fr-col-12 fr-col-md-7" id="col-text">
        <div class="home-title">
          <h1>
            <%= t('.question') %>
          </h1>
          <p>
            <%= t('.answer') %>
          </p>
          <div class="fr-grid-row" id="links">
            <div class="fr-col-12 fr-col-md-6">
              <%= render 'pages/cta_button' %>
            </div>
            <div class="fr-col-12 fr-col-md-6 fr-my-2w fr-my-md-0">
              <%= link_to t('.how-it-works'), comment_ca_marche_path, class: 'blue', data: { turbo: false } %>
            </div>
          </div>
        </div>
      </div>
      <div class="fr-col-12 fr-col-md-5" id="col-image">
        <%= picture_tag { tag.source(srcset: image_path("home-430w.png"), media: "(max-width: 430px)") + tag.source(srcset: image_path("home.webp")) + image_tag("home.png", alt: "", fetchpriority: "high") } %>
      </div>
    </div>
  </div>
</div>
<div class="fr-container-fluid light-blue-bg fr-py-7w home landing">
  <div class="fr-container">
    <% unless in_iframe? %>
      <div id="scroll-section"></div>
      <% if @emphasis_item.present? %>
        <%= render "home_emphasis_item", emphasis_item: @emphasis_item, query_params: query_params %>
      <% end %>
    <% end %>
  </div>
  <div class="fr-container">
    <%= render 'multiple_steps', landing_themes: @landing_themes, landing: @landing %>
  </div>
</div>
<div class="fr-container-fluid section-partners fr-py-7w lighter-blue-bg">
  <div class="fr-container text-center">
    <%= render 'index_institutions' %>
  </div>
</div>
