<% setup_landing_theme_seo_schemas(landing_theme: @landing_theme, landing_subjects: @landing_subjects, landing: @landing) %>
<% cache_unless(flash.present?, [@landing_theme, @landing, @landing_subjects, query_params]) do %>
  <% unless in_iframe? %>
    <div class="fr-container fr-py-7w fr-mt-3v landing-banner">
      <div class="fr-grid-row fr-grid-row--gutters">
        <div class="fr-col-12 fr-col-md-8" id="col-text">
          <div class="title">
            <h1 class="fr-h3"><%= @landing_theme.page_title || @landing_theme.title %></h1>
            <p class="fr-text--lg text-dark-grey"><%= t('landings.landings.home.answer') %></p>
            <div class="fr-grid-row" id="links">
              <div class="fr-col-12">
                <%= render 'pages/cta_button' %>
              </div>
            </div>
          </div>
        </div>
        <div class="fr-col-12 fr-col-md-4" id="col-image">
          <%= header_picture_tag %>
        </div>
      </div>
    </div>
  <% end %>
  <% if show_breadcrumbs? %>
    <%= render 'pages/breadcrumbs', landing: @landing, landing_theme: @landing_theme %>
  <% end %>
  <% unless in_iframe? %>
    <div id="scroll-section"></div>
  <% end %>
  <div class="fr-container--fluid light-blue-bg fr-py-7w landing">
    <div class="fr-container landing-subject-section">
      <h2 class="fr-h3 card-section-header"><%= t('you_wish') %></h2>
      <%= render 'landings/landings/information_banner', landing: @landing, extra_classes: ['fr-m-3v'] %>
      <div class="fr-grid-row fr-grid-row--gutters">
        <%= render partial: 'landings/landing_subjects/card', collection: @landing_subjects, as: :landing_subject, locals: { landing: @landing } %>
        <% unless in_iframe? %>
          <div class="text-center fr-col-12 fr-mt-3w">
            <b><%= t('.back_to_other_subjects_html') %></b>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <% unless in_iframe? %>
    <div class="fr-container--fluid lighter-blue-bg">
      <%= render 'pages/how_it_works_short' %>
    </div>
    <% if @landing_theme.landing_subjects.map{ |ls| ls.solicitable_institutions.with_solicitable_logo }.any? %>
      <div class="fr-container fr-py-7w">
        <h2 class="text-dark-grey text-center text-normal fr-text--lead"><%= t('logos.title') %></h2>
        <%= render 'landings/landings/logos', landing_theme: @landing_theme %>
      </div>
    <% end %>
  <% end %>
  <% if in_iframe? && @landing.display_pde_partnership_mention? %>
    <%= render 'landings/landings/pde_partnership_mention' %>
  <% end %>
<% end %>
