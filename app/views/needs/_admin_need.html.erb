<% cache [need, action, need.experts] do %>
  <div class="card-admin-need fr-my-4w card">
    <div class="card__header">
      <div class="card__title">
        <h2 class="fr-h4"><%= link_to need.company.name, need_path(need, origin: 'reminders') %></h2>
        <p class="fr-card__detail fr-card__detail__lg fr-mt-2v"><%= t('needs.dates.solicited_at', date: l(need.solicited_at, format: :long_sentence)) %></p>
      </div>
      <%= render 'reminders/needs_badges', need: need %>
    </div>
    <div class="fr-card__body fr-text--sm">
      <div class="fr-card__content">
        <div class="card__need fr-mb-2w">
          <div class="card__need-title">
            <h3 class="fr-h6">
              <%= need.subject %>
            </h3>
            <div class="subtitle">
              <p class="fr-card__detail fr-card__detail__lg"><%= need.matches.human_count %></p>
              <% if need.no_activity? %>
                <p class="fr-badge fr-badge--new fr-badge--no-icon fr-badge--sm fr-ml-1w"><%= t('conseiller.diagnoses.last_activity_date', l: l(need.updated_at.to_date, format: :long)) %></p>
              <% end %>
            </div>
          </div>
        </div>
        <div class="card__match-list fr-mb-2w">
          <ul class="fr-p-0 list-dash">
            <% need.matches.preload(expert: :antenne).find_each do |match| %>
              <% expert = match.expert %>
              <li class="item">
                <% if expert.currently_in_reminders? %>
                  <%= raw build_expert_reminders_link(expert) %>
                <% else %>
                  <%= expert.antenne.to_s %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
        <div class="card__feedbacks">
          <div id="display-feedbacks-<%= need.id %>">
            <%= render partial: 'feedbacks/feedback', collection: need.reminder_feedbacks, cached: true %>
          </div>
          <%= render 'feedbacks/form', feedback: need.reminder_feedbacks.new %>
        </div>
      </div>
    </div>
    <div class="card__footer">
      <%= raw build_admin_need_card_footer(action, need) %>
    </div>
  </div>
<% end %>
